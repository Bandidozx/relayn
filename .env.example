# ─── Database ────────────────────────────────────────────────────────────────
# Local default (zero infrastructure, SQLite):
DATABASE_URL="file:./dev.db"
#
# PostgreSQL (production). Set BOTH variables, then run `npm run db:sync && npm run db:deploy`:
# DATABASE_URL="postgresql://relayn:relayn@localhost:5432/relayn?schema=public"
# PRISMA_SCHEMA="prisma/schema.postgres.prisma"

# ─── Application ─────────────────────────────────────────────────────────────
# Used for absolute links in docs/integration snippets and email templates.
APP_URL="http://localhost:3200"
# 32+ random bytes. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""
# Session lifetime in days.
SESSION_TTL_DAYS="7"

# ─── Upstream model providers ────────────────────────────────────────────────
# Provider credentials are read on the server only and are NEVER sent to the browser.
# A provider stays "unconfigured" (and its models are not callable) until its key is set.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

ANTHROPIC_API_KEY=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"

GOOGLE_API_KEY=""
GOOGLE_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"

OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# OpenAI-compatible aggregator gateways. They need no adapter of their own — a base URL and
# a credential is the whole integration. Their catalogues change without notice, so their
# models are loaded with `npm run models:sync` (or Admin → Models → "Sync from providers")
# rather than seeded by hand.
JEROUTER_API_KEY=""
JEROUTER_BASE_URL="https://jerouter.web.id/v1"

MADEFAKA_API_KEY=""
MADEFAKA_BASE_URL="https://api.madefaka.my.id/v1"

# ─── Providers added from the dashboard ──────────────────────────────────────
# Admin → Providers can add an OpenAI-compatible or Anthropic-compatible upstream at runtime,
# with no redeploy. Those credentials cannot be hashed — the gateway has to present the real key
# to the upstream on every request — so they are sealed with AES-256-GCM before they are stored
# and are never returned to a browser (the dashboard only ever sees the last four characters).
#
# This is the sealing key: 32 bytes as 64 hex characters.
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Optional. Left empty, the key is derived from SESSION_SECRET with HKDF-SHA256, which works but
# couples the two: rotating SESSION_SECRET then makes every stored provider credential
# unopenable, and each provider has to be re-entered from Admin → Providers (the failure is
# loud — the provider reports "sealed with a different key", it does not silently stop routing).
# Set it in production so the two secrets can rotate independently. Rotating THIS value has the
# same consequence, so treat it as long-lived and back it up with your other secrets.
PROVIDER_CREDENTIAL_KEY=""

# Deterministic local provider used for development, tests and demos.
# Models seeded with provider="mock" answer from it. Never enable in production.
ENABLE_MOCK_PROVIDER="true"

# ─── Sign in with Google (optional) ──────────────────────────────────────────
# Dashboard sign-in through Google. Unrelated to GOOGLE_API_KEY above, which is a *model*
# credential for Gemini — the two must not be swapped.
#
# Leave both empty and the feature disappears: the login and register pages hide the button
# and nothing else changes. Password sign-in always works.
#
# Setup (Google Cloud Console → APIs & Services → Credentials):
#   1. OAuth consent screen → External → add your email as a test user while unpublished.
#   2. Create credentials → OAuth client ID → Web application.
#   3. Authorised redirect URIs — add every origin you sign in from, exactly:
#        http://localhost:3200/api/auth/oauth/google/callback
#        https://<your-domain>/api/auth/oauth/google/callback
#      A mismatch here is the usual cause of Google's `redirect_uri_mismatch`; the path is
#      derived from APP_URL, so APP_URL must match the origin you actually browse.
#   4. Paste the client id and secret below (the secret is server-only, never sent to a browser).
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# ─── Payments: one-time QRIS purchase (optional) ─────────────────────────────
# Unlimited access costs Rp5.000, paid once through QRIS. The price lives in
# src/lib/plans.ts (UNLIMITED_PRICE_IDR) and is never taken from a request body.
#
# Leave the credentials empty and the feature degrades honestly: the subscription page says
# payments are not enabled and POST /api/payments/checkout returns a 400 naming the missing
# variables. Nothing else changes and no account can reach "unlimited" — the only write path
# to that state is a signature-verified provider callback.
#
# Registry id of the active provider. "tripay" is the only adapter that ships today; the seam
# is src/lib/payments/types.ts (PaymentProvider) if another is added.
PAYMENT_PROVIDER="tripay"
#
# TriPay merchant credentials (Merchant → API):
#   TRIPAY_API_KEY       Bearer token for our outbound calls.
#   TRIPAY_PRIVATE_KEY   HMAC-SHA256 secret. Signs our create-transaction requests AND is the
#                        key the callback signature is verified against. Server-only; it is
#                        never logged, never returned by an API route and never rendered.
#   TRIPAY_MERCHANT_CODE e.g. "T1234". Part of the request signature.
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""
TRIPAY_MERCHANT_CODE=""
# "sandbox" (default) or "production". Selects the API base URL.
TRIPAY_MODE="sandbox"
# Overrides the mode-derived base URL. Rarely needed.
# TRIPAY_BASE_URL="https://tripay.co.id/api-sandbox"
# Channel code. QRIS is the only one this deployment offers.
TRIPAY_PAYMENT_METHOD="QRIS"
#
# Callback URL to register in the TriPay dashboard (Merchant → Callback), exactly:
#   https://<your-domain>/api/payments/webhook/tripay
# It takes no session and no CSRF token — authenticity is the HMAC over the raw body — so it
# must be reachable without cookies. Only status "PAID" with the exact Rp5.000 order amount
# activates anything.

# ─── Payments: one-time crypto purchase (optional) ───────────────────────────
# The second rail to the same permanent unlimited access, priced at $0.50 and settled on-chain.
# Set CRYPTO_PAYMENT_NETWORK and the subscription page shows the crypto card instead of QRIS.
#
# NO PRIVATE KEY IS EVER REQUIRED OR STORED. Relayn only ever *reads* the chain: it verifies a
# transfer that already happened. The receiving address below is public by nature — it is
# rendered to the payer — and the wallet's key lives wherever you keep it, never here.
#
# The payer pastes a transaction hash and nothing else. That hash is an identifier, not
# evidence: chain, token contract, recipient, amount, confirmations and success are all read
# back from the JSON-RPC endpoint server-side, and the amount is compared against
# CRYPTO_PAYMENT_AMOUNT below. No value from the browser can change the verdict.
#
# Chain slug. "" (default) disables the rail entirely. Known: "base" (8453, recommended —
# ~$0.001 of gas per transfer) and "base-sepolia" (84532, testnet).
CRYPTO_PAYMENT_NETWORK=""
# One asset, by design — anything else that arrives is refused rather than converted.
CRYPTO_PAYMENT_ASSET="USDC"
# ERC-20 contract of that asset. Optional on "base": native Circle USDC
# (0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913) is the default. Bridged USDbC is NOT accepted
# unless you name it here. On "base-sepolia" there is no default — you must name a contract.
# CRYPTO_PAYMENT_TOKEN_ADDRESS=""
# Decimals of that contract. USDC is 6 everywhere Circle issues it. Getting this wrong scales
# the required amount by orders of magnitude, so it is explicit rather than inferred.
CRYPTO_PAYMENT_ASSET_DECIMALS="6"
# Public receiving address. Every transfer is matched against this exact address, lowercased.
CRYPTO_PAYMENT_ADDRESS=""
# Price in whole units of the asset, as a decimal string, converted to base units with exact
# integer arithmetic (0.50 USDC → "500000"). A stablecoin is used precisely so that no market
# rate is ever consulted: $0.50 is a fixed token amount, not a quote. Overpayment is accepted;
# one base unit short is not.
#
# This must match the advertised price, UNLIMITED_PRICE_USD_MICRO in src/lib/plans.ts (500_000 =
# $0.50). They are separate authorities — one gates the chain, the other is what the payer is
# told — so evmConfigFromEnv() compares them at boot and disables the whole rail when they
# disagree. Changing the price means changing both; changing only one turns crypto payments off.
CRYPTO_PAYMENT_AMOUNT="0.50"
# JSON-RPC endpoint — the primary source of truth. Defaults to the network's public RPC
# (https://mainnet.base.org). A paid endpoint is worth it in production: the public one is rate
# limited, and a node that cannot be reached leaves payments pending rather than rejected.
# An explorer API is deliberately not used for verification.
# CRYPTO_PAYMENT_RPC_URL=""
# Confirmations required before a transfer counts. Base blocks are ~2s, so 3 is ~6s.
CRYPTO_PAYMENT_MIN_CONFIRMATIONS="3"
# How old a transfer may be and still activate an account. "0" disables the check.
# This stops an unrelated historical transfer to the receiving address from being claimed by
# whoever spots it in the explorer first.
CRYPTO_PAYMENT_MAX_AGE_HOURS="24"
# Read-only explorer base URL, used only for the payer's "view transaction" link.
# CRYPTO_PAYMENT_EXPLORER_URL="https://basescan.org"

# ─── Rate limiting ───────────────────────────────────────────────────────────
# In-process fixed-window limiter (single instance). Swap for Redis in a cluster —
# see src/lib/security/rate-limit.ts.
RATE_LIMIT_PER_MINUTE="60"
RATE_LIMIT_AUTH_PER_MINUTE="10"

# ─── Seeding ─────────────────────────────────────────────────────────────────
# "false" seeds the provider registry and model catalogue only — no demo accounts and no
# sample traffic. Use it for any deployment that real people will sign in to.
SEED_DEMO_DATA="true"
# Password for the two seeded demo accounts. Never reuse it anywhere real.
SEED_DEMO_PASSWORD="relayn-demo-2026"

# ─── Email (architecture only) ───────────────────────────────────────────────
# With no transport configured, verification / reset links are written to the server
# log and (in development only) returned by the API so the flow is testable.
EMAIL_TRANSPORT="log"
EMAIL_FROM="no-reply@relayn.dev"
